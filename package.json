{
  "name": "dndbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local D&D 5e (2014) character builder",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/bundle.mjs",
    "import": "tsx importer/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@tanstack/react-query": "^5.108.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22.13"
  }
}